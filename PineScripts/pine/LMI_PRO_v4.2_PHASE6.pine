         //================================================
// PHASE 6 PART B
// TRADE RESULT TRACKING ENGINE
//================================================


//================================================
// TRADE TRACKING MEMORY
//================================================

var bool tradeActive = false

var float trackedEntry = na

var float trackedSL = na

var float trackedTP = na

var string trackedDirection = "NONE"

var string tradeResult = "WAITING"
var string lastTradeResult = "NONE"



//================================================
// CREATE TRADE MEMORY
//================================================

if buyCondition and not tradeActive


    tradeActive := true

    trackedEntry := entryPrice

    trackedSL := stopLoss

    trackedTP := takeProfit

    trackedDirection := "BUY"

    tradeResult := "ACTIVE"




if sellCondition and not tradeActive


    tradeActive := true

    trackedEntry := entryPrice

    trackedSL := stopLoss

    trackedTP := takeProfit

    trackedDirection := "SELL"

    tradeResult := "ACTIVE"



//================================================
// MONITOR BUY RESULTS
//================================================

if tradeActive and trackedDirection == "BUY"


    if high >= trackedTP

        tradeResult := "WIN"

        tradeActive := false



    else if low <= trackedSL

        tradeResult := "LOSS"

        tradeActive := false



//================================================
// MONITOR SELL RESULTS
//================================================

if tradeActive and trackedDirection == "SELL"


    if low <= trackedTP

        tradeResult := "WIN"

        tradeActive := false



    else if high >= trackedSL

        tradeResult := "LOSS"

        tradeActive := false
        //================================================
// PERFORMANCE STATISTICS MEMORY
//================================================


var int totalTrades = 0

var int winningTrades = 0

var int losingTrades = 0



//================================================
// RECORD TRADE RESULTS
//================================================

var string lastRecordedResult = "NONE"


if tradeResult == "WIN" and lastRecordedResult != "WIN"

    totalTrades += 1

    winningTrades += 1

    lastRecordedResult := "WIN"



if tradeResult == "LOSS" and lastRecordedResult != "LOSS"

    totalTrades += 1

    losingTrades += 1

    lastRecordedResult := "LOSS"


//================================================
// WIN RATE CALCULATION
//================================================

winRate =

     totalTrades > 0 ?

     (winningTrades / totalTrades) * 100 :

     0
     //================================================
