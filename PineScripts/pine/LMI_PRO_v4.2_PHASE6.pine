// PHASE 6 PART D
// AI MARKET INTELLIGENCE COMPARISON ENGINE
//================================================


//================================================
// MARKET CONDITION PERFORMANCE MEMORY
//================================================

var int bullishConditionTrades = 0
var int bullishConditionWins = 0

var int bearishConditionTrades = 0
var int bearishConditionWins = 0

var int rangingConditionTrades = 0
var int rangingConditionWins = 0

var int consolidationTrades = 0
var int consolidationWins = 0



//================================================
// STORE MARKET CONDITION
//================================================

var string trackedCondition = "NONE"


if buyCondition or sellCondition

    trackedCondition := marketCondition



//================================================
// RECORD WINNING CONDITIONS
//================================================

if tradeResult == "WIN"


    if trackedCondition == "BULLISH TREND"

        bullishConditionTrades += 1

        bullishConditionWins += 1



    else if trackedCondition == "BEARISH TREND"

        bearishConditionTrades += 1

        bearishConditionWins += 1



    else if trackedCondition == "RANGING"

        rangingConditionTrades += 1

        rangingConditionWins += 1



    else if trackedCondition == "CONSOLIDATION"

        consolidationTrades += 1

        consolidationWins += 1



//================================================
// RECORD LOSING CONDITIONS
//================================================

if tradeResult == "LOSS"


    if trackedCondition == "BULLISH TREND"

        bullishConditionTrades += 1



    else if trackedCondition == "BEARISH TREND"

        bearishConditionTrades += 1



    else if trackedCondition == "RANGING"

        rangingConditionTrades += 1



    else if trackedCondition == "CONSOLIDATION"

        consolidationTrades += 1



//================================================
// CONDITION PERFORMANCE CALCULATION
//================================================

bullishWinRate =

     bullishConditionTrades > 0 ?

     (bullishConditionWins / bullishConditionTrades) * 100 :

     0



bearishWinRate =

     bearishConditionTrades > 0 ?

     (bearishConditionWins / bearishConditionTrades) * 100 :

     0



rangingWinRate =

     rangingConditionTrades > 0 ?

     (rangingConditionWins / rangingConditionTrades) * 100 :

     0



consolidationWinRate =

     consolidationTrades > 0 ?

     (consolidationWins / consolidationTrades) * 100 :

     0
