//================================================
// AI PERFORMANCE RATING
//================================================


var string aiPerformanceRating = "STARTING"



if totalTrades >= 10


    if winRate >= 70

        aiPerformanceRating := "EXCELLENT"



    else if winRate >= 55

        aiPerformanceRating := "GOOD"



    else if winRate >= 40

        aiPerformanceRating := "AVERAGE"



    else

        aiPerformanceRating := "NEEDS IMPROVEMENT"



//================================================
// BEST SETUP DETECTION
//================================================


var string bestSetup = "NONE"



if aPlusWinRate > aWinRate and aPlusWinRate > bWinRate

    bestSetup := "A+ SETUP"



else if aWinRate > bWinRate

    bestSetup := "A SETUP"



else if bWinRate > 0

    bestSetup := "B SETUP"



//================================================
// BEST MARKET CONDITION
//================================================


var string bestCondition = "NONE"



if bullishWinRate > bearishWinRate and bullishWinRate > rangingWinRate

    bestCondition := "BULLISH TREND"



else if bearishWinRate > rangingWinRate

    bestCondition := "BEARISH TREND"



else if rangingWinRate > 0

    bestCondition := "RANGING"
