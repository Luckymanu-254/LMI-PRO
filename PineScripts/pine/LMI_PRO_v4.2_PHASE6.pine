// PHASE 6 PART C
// AI OPTIMIZATION ENGINE
//================================================


//================================================
// SETUP PERFORMANCE MEMORY
//================================================

var int aPlusTrades = 0

var int aPlusWins = 0


var int aTrades = 0

var int aWins = 0


var int bTrades = 0

var int bWins = 0



//================================================
// STORE ACTIVE SETUP TYPE
//================================================

var string trackedSetup = "NONE"



if buyCondition or sellCondition

    trackedSetup := setupGrade



//================================================
// RECORD SETUP PERFORMANCE
//================================================


if tradeResult == "WIN"


    if trackedSetup == "A+ SETUP"

        aPlusTrades += 1

        aPlusWins += 1



    else if trackedSetup == "A SETUP"

        aTrades += 1

        aWins += 1



    else if trackedSetup == "B SETUP"

        bTrades += 1

        bWins += 1




if tradeResult == "LOSS"


    if trackedSetup == "A+ SETUP"

        aPlusTrades += 1



    else if trackedSetup == "A SETUP"

        aTrades += 1



    else if trackedSetup == "B SETUP"

        bTrades += 1



//================================================
// SETUP WIN RATE CALCULATION
//================================================


aPlusWinRate =

     aPlusTrades > 0 ?

     (aPlusWins / aPlusTrades) * 100 :

     0



aWinRate =

     aTrades > 0 ?

     (aWins / aTrades) * 100 :

     0



bWinRate =

     bTrades > 0 ?

     (bWins / bTrades) * 100 :

     0
