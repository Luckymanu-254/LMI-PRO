//================================================
// SIGNAL MEMORY
//================================================

var int totalSignals = 0

var int buySignals = 0

var int sellSignals = 0



//================================================
// SIGNAL DETECTION MEMORY
//================================================

newBuySignal = buyCondition

newSellSignal = sellCondition

//================================================
// COUNT SIGNALS
//================================================

if enableTestMode


    if newBuySignal

        totalSignals += 1

        buySignals += 1



    if newSellSignal

        totalSignals += 1

        sellSignals += 1



//================================================
// AI SCORE MEMORY
//================================================

var float totalScore = 0

var int scoreSamples = 0



if newBuySignal or newSellSignal

    totalScore += institutionalScore

    scoreSamples += 1



averageAIScore =

     scoreSamples > 0 ?

     totalScore / scoreSamples :

     0
