//@version=6
indicator(
     "LMI PRO v4.1 AI Trade Decision Engine",
     overlay = true,
     max_labels_count = 300,
     max_boxes_count = 100,
     max_lines_count = 100)

//================================================
// PART A
// CORE MARKET STRUCTURE ENGINE
//================================================


//================================================
// GENERAL SETTINGS
//================================================

sensitivity = input.int(
     5,
     "Swing Sensitivity",
     minval = 2,
     maxval = 20)

equalTolerance = input.float(
     0.10,
     "Equal High/Low Tolerance %",
     step = 0.01)

atrLength = input.int(
     14,
     "ATR Length",
     minval = 1)

higherTF = input.timeframe(
     "240",
     "Higher Timeframe Bias")


//================================================
// DISPLAY CONTROL
//================================================

showStructure = input.bool(
     true,
     "Show Market Structure")

showLiquidity = input.bool(
     true,
     "Show Liquidity")


//================================================
// COLOR CONTROL
//================================================

bullColor = input.color(
     color.green,
     "Bullish Color")

bearColor = input.color(
     color.red,
     "Bearish Color")

neutralColor = input.color(
     color.orange,
     "Neutral Color")

liquidityColor = input.color(
     color.yellow,
     "Liquidity Color")

textColor = input.color(
     color.white,
     "Text Color")


// Dashboard colors needed for Part E

dashboardBG = input.color(
     color.new(color.black, 85),
     "Dashboard Background")

dashboardHeader = input.color(
     color.rgb(30, 30, 30),
     "Dashboard Header")


//================================================
// MARKET DATA
//================================================

swingHigh = ta.pivothigh(
     high,
     sensitivity,
     sensitivity)

swingLow = ta.pivotlow(
     low,
     sensitivity,
     sensitivity)

atr = ta.atr(atrLength)


//================================================
// MEMORY STORAGE
//================================================

var float previousHigh = na
var float previousLow = na

var float buyLiquidity = na
var float sellLiquidity = na


var string highStructure = "NONE"
var string lowStructure = "NONE"

var string marketBias = "NEUTRAL"

var string lastEvent = "NONE"


//================================================
// STRUCTURE EVENTS
//================================================

var bool bullishBOS = false
var bool bearishBOS = false

var bool bullishCHoCH = false
var bool bearishCHoCH = false


var string structureEvent = "NONE"

var string trendStrength = "NEUTRAL"


//================================================
// RESET EVENTS EACH CANDLE
//================================================

bullishBOS := false
bearishBOS := false

bullishCHoCH := false
bearishCHoCH := false

structureEvent := "NONE"


//================================================
// SWING HIGH ANALYSIS
//================================================

if not na(swingHigh)

    highStructure :=
         na(previousHigh) ?
         "SH" :
         swingHigh > previousHigh ?
         "HH" :
         "LH"


    if showStructure

        label.new(
             bar_index - sensitivity,
             swingHigh,
             highStructure,
             style = label.style_label_down,
             color = highStructure == "HH" ? bullColor : bearColor,
             textcolor = textColor)


    if not na(previousHigh)

        highDistance =
             previousHigh != 0 ?
             math.abs(swingHigh - previousHigh) / previousHigh * 100 :
             999.0


        if highDistance <= equalTolerance

            buyLiquidity := swingHigh

            lastEvent := "BUY LIQUIDITY CREATED"


            if showLiquidity

                label.new(
                     bar_index - sensitivity,
                     swingHigh,
                     "BUY LIQUIDITY",
                     style = label.style_label_down,
                     color = liquidityColor,
                     textcolor = textColor)


    previousHigh := swingHigh


//================================================
// SWING LOW ANALYSIS
//================================================

if not na(swingLow)

    lowStructure :=
         na(previousLow) ?
         "SL" :
         swingLow > previousLow ?
         "HL" :
         "LL"


    if showStructure

        label.new(
             bar_index - sensitivity,
             swingLow,
             lowStructure,
             style = label.style_label_up,
             color = lowStructure == "HL" ? bullColor : bearColor,
             textcolor = textColor)


    if not na(previousLow)

        lowDistance =
             previousLow != 0 ?
             math.abs(swingLow - previousLow) / previousLow * 100 :
             999.0


        if lowDistance <= equalTolerance

            sellLiquidity := swingLow

            lastEvent := "SELL LIQUIDITY CREATED"


            if showLiquidity

                label.new(
                     bar_index - sensitivity,
                     swingLow,
                     "SELL LIQUIDITY",
                     style = label.style_label_up,
                     color = liquidityColor,
                     textcolor = textColor)


    previousLow := swingLow


//================================================
// BREAK OF STRUCTURE
//================================================

bullishBOS :=
     not na(previousHigh)
     and close > previousHigh


bearishBOS :=
     not na(previousLow)
     and close < previousLow



if bullishBOS

    structureEvent := "BULLISH BOS"
    lastEvent := structureEvent



if bearishBOS

    structureEvent := "BEARISH BOS"
    lastEvent := structureEvent



//================================================
// MARKET BIAS
//================================================

if highStructure == "HH" and lowStructure == "HL"

    marketBias := "BULLISH"

else if highStructure == "LH" and lowStructure == "LL"

    marketBias := "BEARISH"

else

    marketBias := "NEUTRAL"


//================================================
// CHoCH DETECTION
//================================================

bullishCHoCH :=
     marketBias == "BEARISH"
     and bullishBOS


bearishCHoCH :=
     marketBias == "BULLISH"
     and bearishBOS



if bullishCHoCH

    structureEvent := "BULLISH CHoCH"
    lastEvent := structureEvent



if bearishCHoCH

    structureEvent := "BEARISH CHoCH"
    lastEvent := structureEvent



//================================================
// TREND STRENGTH
//================================================

trendStrength :=
     bullishBOS ?
     "STRONG BULLISH" :
     bearishBOS ?
     "STRONG BEARISH" :
     marketBias == "BULLISH" ?
     "BULLISH" :
     marketBias == "BEARISH" ?
     "BEARISH" :
     "NEUTRAL"
     //================================================
// PART B v4.2
// SMART INSTITUTIONAL INTELLIGENCE ENGINE
//================================================


//================================================
// SETTINGS
//================================================

displacementFactor = input.float(
     1.5,
     "Major Displacement Strength",
     minval = 0.5,
     step = 0.1)


fvgMinSize = input.float(
     0.25,
     "Minimum FVG Size ATR",
     minval = 0.05,
     step = 0.05)


obLookback = input.int(
     10,
     "Order Block Search Bars",
     minval = 3,
     maxval = 50)


zoneExtensionBars = input.int(
     20,
     "Zone Extension",
     minval = 5,
     maxval = 100)


showOrderBlocks = input.bool(
     true,
     "Show Order Blocks")


showFVG = input.bool(
     true,
     "Show Fair Value Gaps")


//================================================
// COLORS
//================================================

obBullColor = input.color(
     color.new(color.green,85),
     "Bullish OB Color")


obBearColor = input.color(
     color.new(color.red,85),
     "Bearish OB Color")


fvgBullColor = input.color(
     color.new(color.blue,88),
     "Bullish FVG Color")


fvgBearColor = input.color(
     color.new(color.purple,88),
     "Bearish FVG Color")


//================================================
// LIQUIDITY INTELLIGENCE
//================================================

var string liquidityEvent = "NONE"

var string liquidityType = "NONE"


if not na(buyLiquidity)

    if high > buyLiquidity and close < buyLiquidity

        liquidityEvent := "BUY LIQUIDITY SWEPT"

        liquidityType := "EXTERNAL LIQUIDITY"


        if showLiquidity

            label.new(
                 bar_index,
                 high,
                 "BUY SWEEP",
                 style = label.style_label_down,
                 color = bearColor,
                 textcolor = textColor)



if not na(sellLiquidity)

    if low < sellLiquidity and close > sellLiquidity

        liquidityEvent := "SELL LIQUIDITY SWEPT"

        liquidityType := "EXTERNAL LIQUIDITY"


        if showLiquidity

            label.new(
                 bar_index,
                 low,
                 "SELL SWEEP",
                 style = label.style_label_up,
                 color = bullColor,
                 textcolor = textColor)



//================================================
// DISPLACEMENT ENGINE
//================================================

bullishDisplacement =

     close > open

     and close > high[1]

     and (high-low) > atr * displacementFactor



bearishDisplacement =

     close < open

     and close < low[1]

     and (high-low) > atr * displacementFactor



//================================================
// INSTITUTIONAL CONDITIONS
//================================================

majorBullishZone =

     bullishDisplacement

     and bullishBOS



majorBearishZone =

     bearishDisplacement

     and bearishBOS



//================================================
// ORDER BLOCK MEMORY
//================================================

var float bullishOBTop = na

var float bullishOBBottom = na


var float bearishOBTop = na

var float bearishOBBottom = na


var string bullishOBStrength = "NONE"

var string bearishOBStrength = "NONE"



//================================================
// BULLISH SMART ORDER BLOCK
//================================================

if majorBullishZone and showOrderBlocks


    int bullishOffset = na


    for i = 1 to obLookback

        if na(bullishOffset) and close[i] < open[i]

            bullishOffset := i


    if not na(bullishOffset)

        bullishOBTop := open[bullishOffset]

        bullishOBBottom := low[bullishOffset]


        bullishOBStrength :=

             liquidityEvent == "SELL LIQUIDITY SWEPT" ?

             "HIGH" :

             "MEDIUM"


        box.new(

             left = bar_index - bullishOffset,

             right = bar_index + zoneExtensionBars,

             top = bullishOBTop,

             bottom = bullishOBBottom,

             bgcolor = obBullColor,

             border_color = bullColor,

             text = "BULLISH ORDER BLOCK")



        lastEvent := "SMART BULLISH ORDER BLOCK"
 //================================================
// BEARISH SMART ORDER BLOCK
//================================================

if majorBearishZone and showOrderBlocks


    int bearishOffset = na


    for i = 1 to obLookback

        if na(bearishOffset) and close[i] > open[i]

            bearishOffset := i



    if not na(bearishOffset)


        bearishOBTop := high[bearishOffset]

        bearishOBBottom := open[bearishOffset]


        bearishOBStrength :=

             liquidityEvent == "BUY LIQUIDITY SWEPT" ?

             "HIGH" :

             "MEDIUM"



        box.new(

             left = bar_index - bearishOffset,

             right = bar_index + zoneExtensionBars,

             top = bearishOBTop,

             bottom = bearishOBBottom,

             bgcolor = obBearColor,

             border_color = bearColor,

             text = "BEARISH ORDER BLOCK")



        lastEvent := "SMART BEARISH ORDER BLOCK"



//================================================
// FAIR VALUE GAP INTELLIGENCE
//================================================

bullishFVG =

     low > high[2]

     and (low-high[2]) >= atr * fvgMinSize



bearishFVG =

     high < low[2]

     and (low[2]-high) >= atr * fvgMinSize



var string fvgStatus = "NONE"

var string fvgQuality = "NONE"



//================================================
// BULLISH FVG
//================================================

if bullishFVG and showFVG


    box.new(

         left = bar_index - 2,

         right = bar_index + zoneExtensionBars,

         top = low,

         bottom = high[2],

         bgcolor = fvgBullColor,

         border_color = bullColor,

         text = "BULLISH FVG")



    fvgStatus := "ACTIVE"

    fvgQuality := "VALID"

    lastEvent := "BULLISH FVG CREATED"



//================================================
// BEARISH FVG
//================================================

if bearishFVG and showFVG


    box.new(

         left = bar_index - 2,

         right = bar_index + zoneExtensionBars,

         top = low[2],

         bottom = high,

         bgcolor = fvgBearColor,

         border_color = bearColor,

         text = "BEARISH FVG")



    fvgStatus := "ACTIVE"

    fvgQuality := "VALID"

    lastEvent := "BEARISH FVG CREATED"



//================================================
// PREMIUM / DISCOUNT ENGINE
//================================================

rangeLookback = input.int(

     150,

     "Market Range Lookback",

     minval = 20)



rangeHigh = ta.highest(

     high,

     rangeLookback)



rangeLow = ta.lowest(

     low,

     rangeLookback)



equilibrium =

     (rangeHigh + rangeLow) / 2



priceLocation =

     close > equilibrium ?

     "PREMIUM" :

     "DISCOUNT"    
        //================================================
// PART C v4.2
// ADVANCED AI INTELLIGENCE ENGINE
//================================================


//================================================
// HIGHER TIMEFRAME ANALYSIS
//================================================

htfClose = request.security(
     syminfo.tickerid,
     higherTF,
     close)


htfMA = request.security(
     syminfo.tickerid,
     higherTF,
     ta.sma(close,50))


var string htfBias = "NEUTRAL"



if htfClose > htfMA

    htfBias := "BULLISH"


else if htfClose < htfMA

    htfBias := "BEARISH"


else

    htfBias := "NEUTRAL"



//================================================
// MARKET SESSION ENGINE v4.2 FIXED
//================================================

sessionTimezone = input.string(
     "Etc/UTC",
     "Session Timezone")



currentHour = hour(
     time,
     sessionTimezone)



var string marketSession = "OFF HOURS"



if currentHour >= 0 and currentHour < 8

    marketSession := "ASIAN"



else if currentHour >= 8 and currentHour < 13

    marketSession := "LONDON"



else if currentHour >= 13 and currentHour < 21

    marketSession := "NEW YORK"



else

    marketSession := "OFF HOURS"

//================================================
// VOLATILITY INTELLIGENCE
//================================================

atrAverage = ta.sma(
     atr,
     50)



var string volatilityState = "NORMAL"



if atr > atrAverage * 1.5

    volatilityState := "HIGH VOLATILITY"


else if atr < atrAverage * 0.7

    volatilityState := "LOW VOLATILITY"


else

    volatilityState := "NORMAL"



//================================================
// MARKET CONDITION ENGINE
//================================================

var string marketCondition = "RANGING"



if trendStrength == "STRONG BULLISH"

    marketCondition := "BULLISH TREND"


else if trendStrength == "STRONG BEARISH"

    marketCondition := "BEARISH TREND"


else if volatilityState == "LOW VOLATILITY"

    marketCondition := "CONSOLIDATION"


else

    marketCondition := "RANGING"



//================================================
// AI CONFLUENCE SCORE ENGINE
//================================================

var int institutionalScore = 0


institutionalScore := 0



// Structure

if bullishBOS or bearishBOS

    institutionalScore += 20



// CHoCH

if bullishCHoCH or bearishCHoCH

    institutionalScore += 15



// Liquidity

if liquidityEvent != "NONE"

    institutionalScore += 15



// Order Block

if bullishOBStrength == "HIGH" or bearishOBStrength == "HIGH"

    institutionalScore += 20


else if bullishOBStrength == "MEDIUM" or bearishOBStrength == "MEDIUM"

    institutionalScore += 10



// FVG

if fvgQuality == "VALID"

    institutionalScore += 15



// HTF Alignment

if marketBias == htfBias

    institutionalScore += 15
    //================================================
// AI CONFIDENCE ENGINE
//================================================

var string confidenceLevel = "LOW"



if institutionalScore >= 85

    confidenceLevel := "VERY HIGH"


else if institutionalScore >= 70

    confidenceLevel := "HIGH"


else if institutionalScore >= 50

    confidenceLevel := "MEDIUM"


else

    confidenceLevel := "LOW"



//================================================
// AI SETUP GRADE
//================================================

var string setupGrade = "NO SETUP"



if institutionalScore >= 85

    setupGrade := "A+ SETUP"


else if institutionalScore >= 70

    setupGrade := "A SETUP"


else if institutionalScore >= 50

    setupGrade := "B SETUP"


else

    setupGrade := "WEAK SETUP"



//================================================
// AI DIRECTION ENGINE
//================================================

var string aiDirection = "NEUTRAL"



if marketBias == "BULLISH" and htfBias == "BULLISH"

    aiDirection := "BUY"


else if marketBias == "BEARISH" and htfBias == "BEARISH"

    aiDirection := "SELL"


else

    aiDirection := "WAIT"



//================================================
// RISK ENVIRONMENT ENGINE
//================================================

var string riskEnvironment = "NORMAL"



if volatilityState == "HIGH VOLATILITY"

    riskEnvironment := "HIGH RISK"


else if volatilityState == "LOW VOLATILITY"

    riskEnvironment := "LOW MOMENTUM"


else

    riskEnvironment := "NORMAL"



//================================================
// AI REASONING ENGINE
//================================================

var string aiReasoning = "WAITING FOR CONFIRMATION"



if aiDirection == "BUY"

    aiReasoning :=

         "BULLISH STRUCTURE + INSTITUTIONAL CONFIRMATION"



else if aiDirection == "SELL"

    aiReasoning :=

         "BEARISH STRUCTURE + INSTITUTIONAL CONFIRMATION"



else

    aiReasoning :=

         "NO HIGH QUALITY SETUP"



//================================================
// TRADE READINESS
//================================================

var string tradeStatus = "WAIT"



if institutionalScore >= 70 and aiDirection == "BUY"

    tradeStatus := "BUY READY"


else if institutionalScore >= 70 and aiDirection == "SELL"

    tradeStatus := "SELL READY"


else

    tradeStatus := "WAIT"



//================================================
// AI MARKET SUMMARY
//================================================

var string aiSummary = "NO TRADE"



if tradeStatus == "BUY READY"

    aiSummary := "HIGH QUALITY BUY CONDITIONS"


else if tradeStatus == "SELL READY"

    aiSummary := "HIGH QUALITY SELL CONDITIONS"


else

    aiSummary := "WAIT FOR BETTER CONDITIONS"
   //================================================
// PART D v4.2
// ADVANCED AI TRADE EXECUTION ENGINE
//================================================


//================================================
// RISK MANAGEMENT SETTINGS
//================================================

riskATRMultiplier = input.float(
     1.5,
     "Stop Loss ATR Multiplier",
     minval = 0.5,
     step = 0.1)


rewardMultiplier = input.float(
     2.0,
     "Risk Reward Target",
     minval = 1,
     step = 0.5)


showTradeLevels = input.bool(
     true,
     "Show AI Trade Signals")


//================================================
// TRADE MEMORY
//================================================

var float entryPrice = na

var float stopLoss = na

var float takeProfit = na

var string tradeDirection = "NONE"



//================================================
// SMART BUY CONDITION
//================================================

buyCondition =

     tradeStatus == "BUY READY"

     and marketBias == "BULLISH"

     and htfBias == "BULLISH"

     and confidenceLevel != "LOW"



//================================================
// SMART SELL CONDITION
//================================================

sellCondition =

     tradeStatus == "SELL READY"

     and marketBias == "BEARISH"

     and htfBias == "BEARISH"

     and confidenceLevel != "LOW"



//================================================
// BUY EXECUTION
//================================================

if buyCondition


    entryPrice := close


    stopLoss :=

         close - (atr * riskATRMultiplier)


    takeProfit :=

         entryPrice +

         ((entryPrice - stopLoss)

         * rewardMultiplier)


    tradeDirection := "BUY"



//================================================
// SELL EXECUTION
//================================================

if sellCondition


    entryPrice := close


    stopLoss :=

         close + (atr * riskATRMultiplier)


    takeProfit :=

         entryPrice -

         ((stopLoss - entryPrice)

         * rewardMultiplier)


    tradeDirection := "SELL"



//================================================
// RISK REWARD
//================================================

var float riskReward = na



if not na(entryPrice)


    riskReward :=

         math.abs(takeProfit-entryPrice)

         /

         math.abs(entryPrice-stopLoss)



//================================================
// TRADE QUALITY
//================================================

var string tradeQuality = "LOW QUALITY"



if setupGrade == "A+ SETUP"

    tradeQuality := "A+ SETUP"


else if setupGrade == "A SETUP"

    tradeQuality := "GOOD SETUP"


else if setupGrade == "B SETUP"

    tradeQuality := "AVERAGE SETUP"


else

    tradeQuality := "LOW QUALITY"



//================================================
// AI DECISION
//================================================

var string aiDecision = "NO TRADE"



if tradeDirection == "BUY"

    aiDecision := "HIGH PROBABILITY BUY"


else if tradeDirection == "SELL"

    aiDecision := "HIGH PROBABILITY SELL"


else

    aiDecision := "NO TRADE"



//================================================
// TRADE LABELS
//================================================

if showTradeLevels


    if buyCondition

        label.new(

             bar_index,

             low,

             "AI BUY\nENTRY: " +

             str.tostring(entryPrice),

             style = label.style_label_up,

             color = bullColor,

             textcolor = textColor)



    if sellCondition

        label.new(

             bar_index,

             high,

             "AI SELL\nENTRY: " +

             str.tostring(entryPrice),

             style = label.style_label_down,

             color = bearColor,

             textcolor = textColor) 
        //================================================
// PART E v4.2
// AI PROFESSIONAL DASHBOARD
//================================================


//================================================
// DASHBOARD SETTINGS
//================================================

dashboardPosition = input.string(

     "TOP RIGHT",

     "Dashboard Position",

     options = [

          "TOP RIGHT",

          "TOP LEFT",

          "BOTTOM RIGHT",

          "BOTTOM LEFT"

     ])



showMiniDashboard = input.bool(

     true,

     "Show AI Dashboard")



//================================================
// DASHBOARD POSITION
//================================================

dashboardPos =

     dashboardPosition == "TOP LEFT" ?

     position.top_left :

     dashboardPosition == "BOTTOM RIGHT" ?

     position.bottom_right :

     dashboardPosition == "BOTTOM LEFT" ?

     position.bottom_left :

     position.top_right



//================================================
// DASHBOARD CREATION
//================================================

var table dashboard = table.new(

     dashboardPos,

     2,

     18,

     bgcolor = color.black,

     frame_color = color.gray,

     frame_width = 1)



//================================================
// DASHBOARD DISPLAY
//================================================

if barstate.islast and showMiniDashboard


    table.cell(

         dashboard,

         0,

         0,

         "LMI PRO v4.2",

         bgcolor = dashboardHeader,

         text_color = textColor)



    table.cell(

         dashboard,

         1,

         0,

         "AI ENGINE",

         bgcolor = dashboardHeader,

         text_color = textColor)



    // DECISION

    table.cell(

         dashboard,

         0,

         1,

         "DECISION",

         bgcolor = dashboardBG,

         text_color = textColor)


    table.cell(

         dashboard,

         1,

         1,

         aiDecision,

         bgcolor =

              aiDecision == "HIGH PROBABILITY BUY" ?

              bullColor :

              aiDecision == "HIGH PROBABILITY SELL" ?

              bearColor :

              neutralColor,

         text_color = textColor)



    // SCORE

    table.cell(

         dashboard,

         0,

         2,

         "AI SCORE",

         bgcolor = dashboardBG,

         text_color = textColor)



    table.cell(

         dashboard,

         1,

         2,

         str.tostring(institutionalScore)+"/100",

         bgcolor = dashboardBG,

         text_color = textColor)



    // CONFIDENCE

    table.cell(

         dashboard,

         0,

         3,

         "CONFIDENCE",

         bgcolor = dashboardBG,

         text_color = textColor)



    table.cell(

         dashboard,

         1,

         3,

         confidenceLevel,

         bgcolor = dashboardBG,

         text_color = textColor)



    // SETUP GRADE

    table.cell(

         dashboard,

         0,

         4,

         "SETUP",

         bgcolor = dashboardBG,

         text_color = textColor)



    table.cell(

         dashboard,

         1,

         4,

         setupGrade,

         bgcolor = dashboardBG,

         text_color = textColor)



    // MARKET BIAS

    table.cell(

         dashboard,

         0,

         5,

         "BIAS",

         bgcolor = dashboardBG,

         text_color = textColor)



    table.cell(

         dashboard,

         1,

         5,

         marketBias,

         bgcolor = dashboardBG,

         text_color = textColor)



    // HTF

    table.cell(

         dashboard,

         0,

         6,

         "HTF",

         bgcolor = dashboardBG,

         text_color = textColor)



    table.cell(

         dashboard,

         1,

         6,

         htfBias,

         bgcolor = dashboardBG,

         text_color = textColor)



    // ZONE QUALITY

    table.cell(

         dashboard,

         0,

         7,

         "OB QUALITY",

         bgcolor = dashboardBG,

         text_color = textColor)



    table.cell(

         dashboard,

         1,

         7,

         bullishOBStrength != "NONE" ?

         bullishOBStrength :

         bearishOBStrength,

         bgcolor = dashboardBG,

         text_color = textColor)



    // FVG

    table.cell(

         dashboard,

         0,

         8,

         "FVG",

         bgcolor = dashboardBG,

         text_color = textColor)



    table.cell(

         dashboard,

         1,

         8,

         fvgQuality,

         bgcolor = dashboardBG,

         text_color = textColor)     
       //================================================
// DASHBOARD FINAL INFORMATION
//================================================


// ENTRY

table.cell(

     dashboard,

     0,

     9,

     "ENTRY",

     bgcolor = dashboardBG,

     text_color = textColor)



table.cell(

     dashboard,

     1,

     9,

     na(entryPrice) ?

     "NONE" :

     str.tostring(entryPrice),

     bgcolor = dashboardBG,

     text_color = textColor)



// STOP LOSS

table.cell(

     dashboard,

     0,

     10,

     "STOP LOSS",

     bgcolor = dashboardBG,

     text_color = textColor)



table.cell(

     dashboard,

     1,

     10,

     na(stopLoss) ?

     "NONE" :

     str.tostring(stopLoss),

